+    /**
+     * Downloads the recommended GGUF into app-private storage, supports resuming a partial
+     * download, verifies SHA-256, then registers it as the COORDINATOR model.
+     * Progress is an integer percentage; a failed network transfer leaves a .part file to resume.
+     */
+    suspend fun downloadRecommendedCoordinator(
+        context: Context,
+        onProgress: (Int) -> Unit = {}
+    ): StoredModel = withContext(Dispatchers.IO) {
+        val model = recommendedCoordinator
+        val directory = File(context.filesDir, MODEL_DIR).apply { mkdirs() }
+        val partial = File(directory, "qwen35_2b_q4_k_m.gguf.part")
+        val destination = File(directory, "qwen35_2b_q4_k_m.gguf")
+        val storage = StatFs(context.filesDir.absolutePath)
+        val remainingEstimate = (model.approximateBytes - partial.length()).coerceAtLeast(0L)
+        val requiredFree = (remainingEstimate + 128L * 1024L * 1024L).coerceAtLeast(256L * 1024L * 1024L)
+        require(storage.availableBytes >= requiredFree) {
+            "Không đủ dung lượng trống. Cần tối thiểu ${(requiredFree / (1024L * 1024L))} MiB trống trước khi tải."
+        }
+
+        var connection: HttpURLConnection? = null
+        try {
+            var existingBytes = partial.length()
+            val request = (URL(model.downloadUrl).openConnection() as HttpURLConnection).apply {
+                connectTimeout = 25_000
+                readTimeout = 60_000
+                instanceFollowRedirects = true
+                requestMethod = "GET"
+                setRequestProperty("User-Agent", "MultiAI-Trading-Council-Android/0.2")
+                setRequestProperty("Accept-Encoding", "identity")
+                if (existingBytes > 0L) setRequestProperty("Range", "bytes=$existingBytes-")
+            }
+            connection = request
+            val status = request.responseCode
+            val append = existingBytes > 0L && status == HttpURLConnection.HTTP_PARTIAL
+            require(status == HttpURLConnection.HTTP_OK || status == HttpURLConnection.HTTP_PARTIAL) {
+                "Máy chủ tải mô hình trả về HTTP $status. Hãy thử lại khi mạng ổn định."
+            }
+            if (!append) {
+                existingBytes = 0L
+                partial.delete()
+            }
+
+            val totalFromRange = request.getHeaderField("Content-Range")
+                ?.substringAfterLast('/')
+                ?.toLongOrNull()
+            val bodyLength = request.contentLengthLong
+            val totalBytes = totalFromRange ?: if (bodyLength > 0L) bodyLength + existingBytes else model.approximateBytes
+
+            val digest = MessageDigest.getInstance("SHA-256")
+            if (append && partial.isFile) {
+                BufferedInputStream(FileInputStream(partial)).use { input ->
+                    val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+                    while (true) {
+                        val read = input.read(buffer)
+                        if (read < 0) break
+                        digest.update(buffer, 0, read)
+                    }
+                }
+            }
+
+            var downloaded = existingBytes
+            var lastPercent = -1
+            onProgress(((downloaded * 100L) / totalBytes.coerceAtLeast(1L)).toInt().coerceIn(0, 99))
+            BufferedInputStream(request.inputStream).use { input ->
+                BufferedOutputStream(FileOutputStream(partial, append)).use { output ->
+                    val buffer = ByteArray(1024 * 1024)
+                    while (true) {
+                        val read = input.read(buffer)
+                        if (read < 0) break
+                        output.write(buffer, 0, read)
+                        digest.update(buffer, 0, read)
+                        downloaded += read
+                        val percent = ((downloaded * 100L) / totalBytes.coerceAtLeast(1L)).toInt().coerceIn(0, 99)
+                        if (percent != lastPercent) {
+                            lastPercent = percent
+                            onProgress(percent)
+                        }
+                    }
+                    output.flush()
+                }
+            }
+
+            val actualSha = digest.digest().joinToString("") { "%02x".format(it.toInt() and 0xff) }
+            if (!actualSha.equals(model.sha256, ignoreCase = true)) {
+                partial.delete()
+                error("Kiểm tra SHA-256 thất bại. Tệp tải về không khớp bản công bố; đã xóa tệp lỗi để bảo vệ thiết bị.")
+            }
+            require(partial.length() > 1_000_000_000L) {
+                partial.delete()
+                "Tệp tải về quá nhỏ, không phải mô hình GGUF hoàn chỉnh."
+            }
+            if (destination.exists()) require(destination.delete()) { "Không thể thay thế tệp mô hình cũ." }
+            require(partial.renameTo(destination)) { "Không thể đưa mô hình đã xác minh vào thư viện." }
+
+            val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+            val oldName = prefs.getString(ModelRole.COORDINATOR.name, null)
+            prefs.edit().putString(ModelRole.COORDINATOR.name, destination.name).apply()
+            oldName?.takeIf { it != destination.name }?.let { File(directory, it).takeIf(File::isFile)?.delete() }
+            onProgress(100)
+            StoredModel(ModelRole.COORDINATOR, destination, destination.length())
+        } catch (e: Exception) {
+            // Preserve only partial network downloads for a later Range request. Bad hashes are deleted above.
+            throw e
+        } finally {
+            connection?.disconnect()
+        }
+    }
